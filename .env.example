# Optional production configuration.
# The local Urban Air Quality Assistant uses deterministic adapters and does not require these values.

# Web server
PORT=3000
HOST=0.0.0.0

# Local mock air-quality sensor profiles (src/airquality.js)
AIRQUALITY_LOCATIONS=Delhi,Bangkok,Singapore,Tokyo,Sydney

# Air quality data provider (provider-specific credentials)
AIRQUALITY_API_KEY=replace-me
AIRQUALITY_HOST=https://api.airnowapi.org

# LLM provider for the assistant narrative
LLM_API_KEY=replace-me
